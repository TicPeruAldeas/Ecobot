{
  "version": "6.3",
  "screens": [
    {
      "id": "FOTOS",
      "title": "Fotos de los residuos",
      "terminal": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "Adjunte fotografías claras de los residuos que desea donar."
          },
          {
            "type": "TextBody",
            "text": "Las imágenes nos permiten calcular el espacio y peso necesarios para programar el recojo."
          },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "PhotoPicker",
                "name": "fotos",
                "label": "Fotografías",
                "description": "Puede tomar fotos o elegir hasta 10 de su galería.",
                "photo-source": "camera_gallery",
                "min-uploaded-photos": 1,
                "max-uploaded-photos": 10,
                "max-file-size-kb": 10240
              },
              {
                "type": "Footer",
                "label": "Enviar fotos",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "photos": "${form.fotos}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
