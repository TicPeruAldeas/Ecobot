# ── Obligatorias ─────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_VERIFY_TOKEN=            # lo inventas tú; el mismo va en Meta
WHATSAPP_PHONE_NUMBER_ID=         # phone_number_id del número de ECO
WHATSAPP_TOKEN=                   # token permanente para enviar
ADMIN_SESSION_SECRET=             # firma de la cookie del panel

# ── Muy recomendadas ─────────────────────────────────────────
META_APP_SECRET=                  # valida la firma X-Hub-Signature-256 (admite META_APP_SECRET_2, _3…)
ADMIN_USERS=jordan:clave:admin    # usuario:clave:rol  (rol = admin | logistica | lectura), separados por coma

# ── Consulta de RUC en SUNAT ─────────────────────────────────
RUC_API_PROVIDER=apisnet          # apisnet | apiperu | decolecta | custom
RUC_API_TOKEN=                    # token del proveedor (apisnet sin token usa la v1 gratuita, con límite)
RUC_API_URL=                      # solo para custom: URL con {ruc}

# ── Correo ──────────────────────────────────────────────────
# Opción 1 (recomendada en Railway): API de Gmail por HTTPS con OAuth2. Cliente OAuth de Google Cloud
# (tipo "Aplicación web") con la URI de redirección https://<app>.up.railway.app/admin/oauth/google/callback.
# Luego en el panel → Configuración → "Conectar Gmail" con la cuenta que enviará.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opción 2: SMTP (Railway puede bloquear los puertos 587/465; si ves "Connection timeout", usa la opción 1)
SMTP_HOST=smtp.office365.com     # servidor SMTP del dominio
SMTP_PORT=587
SMTP_USER=reciclaje@aldeastic.org.pe   # buzón que envía
SMTP_PASS=                        # contraseña o contraseña de aplicación
MAIL_FROM="ECO · Aldeas Infantiles SOS Perú <reciclaje@aldeastic.org.pe>"
MAIL_NOTIFY_TO=                   # correos internos (logística) que reciben aviso de cada reserva, separados por coma

# ── Opcionales ───────────────────────────────────────────────
WA_TEMPLATE_RECORDATORIO=         # nombre de la plantilla aprobada en Meta para recordatorios
WA_TEMPLATE_LANG=es
WA_TEMPLATE_CAMBIO=               # plantilla para avisar reprogramación/cancelación hecha desde el panel
STORAGE_BUCKET=eco-fotos
AUTOSERVICIO_RESERVAS=0           # 1 = el donante puede reprogramar/cancelar por WhatsApp ("mis reservas"). Apagado: solo desde el panel
FOTO_AGRUPAR_MS=4000              # espera (ms) tras la última foto de un álbum antes de responder una sola vez
TEST_ALLOWED_NUMBERS=             # modo prueba: "51999000111,51988777666" → solo atiende a esos números. Vacío en producción
SESSION_TTL_MINUTES=30            # inactividad tras la cual el bot reinicia desde la bienvenida (también editable en el panel: sesion_minutos)
MAX_INBOUND_MESSAGE_AGE_SECONDS=180
REMINDER_SWEEP_MINUTES=10
PORT=3000
WA_FLOW_FOTOS_ID=                 # opcional: id del WhatsApp Flow "eco_fotos" (selector de fotos). Vacío = fotos sueltas por el chat
WA_FLOW_FOTOS_MODE=               # "draft" para probar el Flow sin publicarlo; vacío = publicado
