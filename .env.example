# ── Obligatorias ─────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_VERIFY_TOKEN=            # lo inventas tú; el mismo va en Meta
WHATSAPP_PHONE_NUMBER_ID=         # phone_number_id del número de ECO
WHATSAPP_TOKEN=                   # token permanente para enviar
ADMIN_SESSION_SECRET=             # firma de la cookie del panel

# ── Muy recomendadas ─────────────────────────────────────────
META_APP_SECRET=                  # valida la firma X-Hub-Signature-256 (admite META_APP_SECRET_2, _3…)
MAKE_WEBHOOK_URL=                 # webhook de Make que escribe en la hoja USUARIOS RUC
ADMIN_USERS=jordan:clave:admin    # usuario:clave:rol  (rol = admin | logistica | lectura), separados por coma

# ── Consulta de RUC en SUNAT ─────────────────────────────────
RUC_API_PROVIDER=apisnet          # apisnet | apiperu | decolecta | custom
RUC_API_TOKEN=                    # token del proveedor (apisnet sin token usa la v1 gratuita, con límite)
RUC_API_URL=                      # solo para custom: URL con {ruc}

# ── Opcionales ───────────────────────────────────────────────
MAKE_WEBHOOK_SECRET=              # si Make valida un header x-make-apikey
WA_TEMPLATE_RECORDATORIO=         # nombre de la plantilla aprobada en Meta para recordatorios
WA_TEMPLATE_LANG=es
WA_TEMPLATE_CAMBIO=               # plantilla para avisar reprogramación/cancelación hecha desde el panel
STORAGE_BUCKET=eco-fotos
TEST_ALLOWED_NUMBERS=             # modo prueba: "51999000111,51988777666" → solo atiende a esos números. Vacío en producción
SESSION_TTL_HOURS=12              # tiempo de inactividad tras el cual se reinicia el flujo
MAX_INBOUND_MESSAGE_AGE_SECONDS=180
REMINDER_SWEEP_MINUTES=10
PORT=3000
